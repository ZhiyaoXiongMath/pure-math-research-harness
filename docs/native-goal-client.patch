+// PMRS 4.2.2: pre-sampling admission applies ONLY to the product root thread.
+// Native subagents (all models, depth, number, and duration) bypass this gate.
+// Missing host, rejected admission, malformed reply or I/O failure is closed.
+#[cfg(unix)]
+async fn pmrs_root_turn_admission(
+    session: &Arc<Session>,
+    request: &mut TurnInputRequest,
+    turn_id: &str,
+) -> CodexResult<()> {
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+    use tokio::net::UnixStream;
+    let Some(socket_path) = std::env::var_os("PMRS_NATIVE_MAIN_GATE") else { return Ok(()); };
+    if matches!(session.state.lock().await.session_configuration.session_source,
+        SessionSource::SubAgent(_)) || session.active_turn.lock().await.is_some() {
+        return Ok(());
+    }
+    let exchange = async {
+        let mut stream = UnixStream::connect(socket_path).await.map_err(|e| e.to_string())?;
+        let body = serde_json::json!({"schema":"pmrs.native-turn-admission/1",
+            "thread_id":session.thread_id.to_string(),"turn_id":turn_id,
+            "turn_trigger":request.start.turn_trigger,
+            "gate_revision":"pmrs.native-admission/1"});
+        stream.write_all(format!("{}\n", body).as_bytes()).await.map_err(|e| e.to_string())?;
+        let mut reader = BufReader::new(stream);
+        let mut line = String::new();
+        reader.read_line(&mut line).await.map_err(|e| e.to_string())?;
+        if line.len() > 4 * 1024 * 1024 { return Err("oversized gate response".to_string()); }
+        let reply: serde_json::Value = serde_json::from_str(&line).map_err(|e| e.to_string())?;
+        if reply.get("allow").and_then(|v| v.as_bool()) != Some(true) {
+            return Err(format!("PMRS admission denied: {}", reply.get("reason").unwrap_or(&serde_json::Value::Null)));
+        }
+        let request_id = reply.get("request_id").and_then(|v| v.as_str()).ok_or("missing PMRS request identity")?;
+        let context = reply.get("additional_context").and_then(|v| v.as_str()).ok_or("missing PMRS input")?;
+        request.additional_context.insert(format!("pmrs_request_{}", request_id), AdditionalContextEntry {
+            value: context.to_string(), kind: codex_protocol::protocol::AdditionalContextKind::Application,
+        });
+        request.responsesapi_client_metadata.get_or_insert_with(HashMap::new)
+            .insert("pmrs_request_id".to_string(), request_id.to_string());
+        Ok::<(),String>(())
+    };
+    tokio::time::timeout(std::time::Duration::from_secs(30), exchange).await
+        .map_err(|_| CodexErr::InvalidRequest("PMRS native admission unavailable (timeout)".to_string()))?
+        .map_err(|e| CodexErr::InvalidRequest(format!("PMRS native admission unavailable: {e}")))
+}
+#[cfg(not(unix))]
+async fn pmrs_root_turn_admission(_session: &Arc<Session>, _request: &mut TurnInputRequest, _turn_id: &str) -> CodexResult<()> {
+    if std::env::var_os("PMRS_NATIVE_MAIN_GATE").is_some() {
+        return Err(CodexErr::InvalidRequest("PMRS native admission requires Unix sockets".to_string()));
+    }
+    Ok(())
+}
